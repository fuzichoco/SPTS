@model SPTS.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-wrap">
    <section class="auth-art">
        <a asp-controller="Home" asp-action="Index" class="brand p-0 position-relative" style="z-index:1">
            <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
            <span><strong>SPTS</strong><small style="color:#c9d6ff">Student Progress Tracking System</small></span>
        </a>
        <div class="position-relative" style="z-index:1">
            <h1>Theo dõi tiến độ học tập, rõ ràng từng tín chỉ.</h1>
            <p class="mb-4">Một nơi cho sinh viên xem GPA và lộ trình CTĐT, cho giáo vụ nhập điểm và báo cáo, cho quản trị viên quản lý hệ thống.</p>
            <div class="auth-feature"><i class="bi bi-graph-up-arrow"></i><span>Tiến độ, GPA hệ 4 và hệ 10 tự động</span></div>
            <div class="auth-feature"><i class="bi bi-pencil-square"></i><span>Nhập điểm nhanh, tự quy đổi điểm chữ</span></div>
            <div class="auth-feature"><i class="bi bi-shield-check"></i><span>Phân quyền theo vai trò, ghi nhật ký mọi thao tác</span></div>
        </div>
        <small class="position-relative" style="z-index:1;color:#9fb0e0">© 2026 Nhóm BTL Web nâng cao</small>
    </section>
    <section class="auth-form">
        <div class="auth-card">
            <h2 class="mb-1">Chào mừng trở lại 👋</h2>
            <p class="text-muted mb-4">Đăng nhập để tiếp tục vào hệ thống.</p>
            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <div class="input-icon"><i class="bi bi-person"></i><input asp-for="Username" class="form-control" autocomplete="username" placeholder="vd: sv2310001" autofocus /></div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-icon"><i class="bi bi-lock"></i><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" /></div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button class="btn btn-primary w-100 py-2 fw-semibold">Đăng nhập <i class="bi bi-arrow-right ms-1"></i></button>
            </form>
            <p class="text-muted small mt-3 mb-3"><i class="bi bi-info-circle me-1"></i>Sai mật khẩu 5 lần, tài khoản bị tạm khóa 15 phút.</p>
            <div class="demo-accounts">
                <strong class="d-block mb-1 text-dark">Tài khoản demo</strong>
                Quản trị: <code>admin</code> / <code>Admin@123</code><br />
                Giáo vụ: <code>giaovu</code> / <code>Staff@123</code><br />
                Sinh viên: <code>sv2310001</code> / <code>Student@123</code>
            </div>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
