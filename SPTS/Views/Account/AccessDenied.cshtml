@{ ViewData["Title"] = "Không có quyền truy cập"; }
<div class="status-page">
    <div>
        <div class="stat-icon tone-red mx-auto mb-3" style="width:80px;height:80px;font-size:2.2rem;border-radius:24px"><i class="bi bi-shield-x"></i></div>
        <div class="status-code" style="color:var(--bad)">403</div>
        <h3 class="fw-bold mt-2">@ViewData["Title"]</h3>
        <p class="text-muted">Tài khoản của bạn không được phép xem trang này. Liên hệ quản trị viên nếu cần cấp quyền.</p>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Về trang chủ</a>
    </div>
</div>
