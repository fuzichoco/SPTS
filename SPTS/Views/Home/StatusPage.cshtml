@{
    int code = ViewBag.Code;
    var (title, message) = code switch
    {
        404 => ("Không tìm thấy trang", "Trang này chưa có hoặc đã bị gỡ."),
        400 => ("Yêu cầu không hợp lệ", "Phiên làm việc của biểu mẫu đã hết hạn. Hãy tải lại trang rồi thử lại."),
        _ => ("Đã có lỗi xảy ra", "Vui lòng thử lại sau.")
    };
    ViewData["Title"] = title;
}
<div class="text-center mt-5">
    <h1 class="display-4 text-secondary">@code</h1>
    <h3>@title</h3>
    <p class="text-muted">@message</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Về trang chủ</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Đăng nhập</a>
    }
</div>
