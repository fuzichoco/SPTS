@{
    int code = ViewBag.Code;
    var (title, message) = code switch
    {
        404 => ("Không tìm thấy trang", "Trang này chưa có hoặc đã bị gỡ."),
        400 => ("Yêu cầu không hợp lệ", "Phiên làm việc của biểu mẫu đã hết hạn. Hãy tải lại trang rồi thử lại."),
        _ => ("Đã có lỗi xảy ra", "Vui lòng thử lại sau.")
    };
    ViewData["Title"] = title;
}
<div class="status-page">
    <div>
        <div class="status-code grad-text">@code</div>
        <h3 class="fw-bold mt-2">@title</h3>
        <p class="text-muted">@message</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Về trang chủ</a>
        }
        else
        {
            <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary">Đăng nhập</a>
        }
    </div>
</div>
