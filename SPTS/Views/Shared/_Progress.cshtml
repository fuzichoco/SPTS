@model ProgressViewModel
@{
    string Fmt(decimal? v) => v?.ToString("0.0") ?? "—";
    var semLabels = Model.Semesters.Select(s => s.SemesterName).ToList();
}
<div class="card hero-card mb-4">
    <div class="card-body p-4 position-relative" style="z-index:1">
        <div class="row g-4 align-items-center">
            <div class="col-lg-auto text-center">
                <div class="ring mx-auto" style="--p:@Model.Percent">
                    <div><strong>@Model.Percent%</strong><small>tiến độ CTĐT</small></div>
                </div>
            </div>
            <div class="col-lg">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h2 class="fw-bold mb-0">@Model.FullName</h2>
                    <span class="pill" style="background:rgba(255,255,255,.15);color:#fff">@Model.Status</span>
                </div>
                <div class="muted mb-3">MSSV @Model.StudentCode · Lớp @Model.ClassCode · @Model.ProgramName</div>
                <div class="row g-2">
                    <div class="col-6 col-md-3"><div class="hero-metric"><div class="v">@Model.Gpa4.ToString("0.00")</div><div class="l">GPA hệ 4</div></div></div>
                    <div class="col-6 col-md-3"><div class="hero-metric"><div class="v">@Model.Gpa10.ToString("0.00")</div><div class="l">Điểm TB hệ 10</div></div></div>
                    <div class="col-6 col-md-3"><div class="hero-metric"><div class="v">@Model.PassedCredits<small class="fs-6 muted">/@Model.TotalCredits</small></div><div class="l">Tín chỉ tích lũy</div></div></div>
                    <div class="col-6 col-md-3"><div class="hero-metric"><div class="v">@(Model.AttemptedCredits > 0 ? Model.Rank : "—")</div><div class="l">Xếp loại học lực</div></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsWarned)
{
    <div class="alert alert-danger d-flex gap-3 align-items-center border-0 shadow-sm" style="border-radius:14px">
        <i class="bi bi-exclamation-octagon-fill fs-3"></i>
        <div><strong>Cảnh báo học vụ:</strong> GPA tích lũy dưới 2.0. Cần đăng ký học lại các học phần chưa đạt và liên hệ cố vấn học tập.</div>
    </div>
}
else if (Model.FailedCourses > 0)
{
    <div class="alert alert-warning d-flex gap-3 align-items-center border-0 shadow-sm" style="border-radius:14px">
        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        <div>Còn <strong>@Model.FailedCourses</strong> học phần chưa đạt, cần học lại để hoàn thành CTĐT.</div>
    </div>
}

<ul class="nav nav-tabs-modern mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-sem" type="button"><i class="bi bi-calendar3 me-1"></i>Kết quả học kỳ</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-prog" type="button"><i class="bi bi-map me-1"></i>Chương trình đào tạo</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-chart" type="button"><i class="bi bi-graph-up me-1"></i>Biểu đồ</button></li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-sem">
        @foreach (var s in Model.Semesters.AsEnumerable().Reverse())
        {
            <div class="card mb-3">
                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <span class="section-title">@s.SemesterName</span>
                    <span class="d-flex gap-2"><span class="pill">@s.Credits tín chỉ</span><span class="pill info">GPA @s.Gpa4.ToString("0.00")</span><span class="pill">TB @s.Gpa10.ToString("0.00")</span></span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Học phần</th><th>TC</th><th>Lần</th><th class="text-center">CC</th><th class="text-center">GK</th><th class="text-center">CK</th><th class="text-center">Tổng</th><th class="text-center">Chữ</th><th>Kết quả</th></tr></thead>
                        <tbody>
                        @foreach (var g in s.Grades)
                        {
                            <tr>
                                <td><span class="code me-1">@g.CourseCode</span><span class="cell-main">@g.CourseName</span></td>
                                <td>@g.Credits</td>
                                <td>@g.AttemptNo</td>
                                <td class="text-center">@Fmt(g.AttendanceScore)</td>
                                <td class="text-center">@Fmt(g.MidtermScore)</td>
                                <td class="text-center">@Fmt(g.FinalScore)</td>
                                <td class="text-center fw-bold">@Fmt(g.TotalScore)</td>
                                <td class="text-center"><span class="grade-letter @g.LetterGrade?[..1]">@(g.LetterGrade ?? "—")</span></td>
                                <td>@if (g.TotalScore == null) { <span class="pill">Chưa đủ điểm</span> } else if (g.IsPassed) { <span class="pill ok"><i class="bi bi-check-circle"></i>Đạt</span> } else { <span class="pill bad"><i class="bi bi-x-circle"></i>Chưa đạt</span> }</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (!Model.Semesters.Any())
        {
            <div class="card"><div class="empty"><i class="bi bi-journal"></i>Chưa có kết quả học tập.</div></div>
        }
    </div>
    <div class="tab-pane fade" id="tab-prog">
        <div class="card">
            <div class="card-header d-flex flex-wrap gap-3 align-items-center">
                <span class="section-title me-auto">Lộ trình CTĐT</span>
                <span class="small"><span class="course-status Passed me-1"></span>Đạt</span>
                <span class="small"><span class="course-status Failed me-1"></span>Chưa đạt</span>
                <span class="small"><span class="course-status NotTaken me-1"></span>Chưa học</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>HK</th><th>Học phần</th><th>TC</th><th>Khối</th><th>Loại</th><th class="text-center">Điểm tốt nhất</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                    @foreach (var pc in Model.ProgramCourses)
                    {
                        <tr>
                            <td><span class="pill">HK @pc.SuggestedSemester</span></td>
                            <td><span class="code me-1">@pc.CourseCode</span><span class="cell-main">@pc.CourseName</span></td>
                            <td>@pc.Credits</td>
                            <td class="small">@pc.KnowledgeBlock</td>
                            <td>@if (pc.IsRequired) { <span class="pill info">Bắt buộc</span> } else { <span class="pill warn">Tự chọn</span> }</td>
                            <td class="text-center fw-bold">@Fmt(pc.BestScore) @if (pc.LetterGrade != null) { <span class="grade-letter ms-1 @pc.LetterGrade[..1]">@pc.LetterGrade</span> }</td>
                            <td><span class="course-status @pc.Status me-1"></span>@(pc.Status switch { CourseStatus.Passed => "Đạt", CourseStatus.Failed => "Chưa đạt", _ => "Chưa học" })</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="tab-chart">
        <div class="row g-3">
            <div class="col-lg-7"><div class="card"><div class="card-header">GPA theo học kỳ</div><div class="card-body"><div class="chart-wrap"><canvas id="gpaChart"></canvas></div></div></div></div>
            <div class="col-lg-5"><div class="card"><div class="card-header">Tín chỉ CTĐT</div><div class="card-body"><div class="chart-wrap"><canvas id="creditChart"></canvas></div></div></div></div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>Chart.defaults.maintainAspectRatio = false; Chart.defaults.font.family = "Be Vietnam Pro";</script>
<script>
    (function () {
        const labels = @Json.Serialize(semLabels);
        new Chart(document.getElementById('gpaChart'), {
            type: 'line',
            data: { labels, datasets: [
                { label: 'GPA hệ 4', data: @Json.Serialize(Model.Semesters.Select(s => s.Gpa4)), borderColor: '#2f5bea', backgroundColor: 'rgba(47,91,234,.12)', fill: true, tension: .35, yAxisID: 'y' },
                { label: 'Điểm TB hệ 10', data: @Json.Serialize(Model.Semesters.Select(s => s.Gpa10)), borderColor: '#22c1c3', tension: .35, yAxisID: 'y1' }
            ] },
            options: { scales: { y: { min: 0, max: 4, title: { display: true, text: 'Hệ 4' } }, y1: { min: 0, max: 10, position: 'right', grid: { drawOnChartArea: false } } } }
        });
        const remain = Math.max(0, @Model.TotalCredits - @Model.PassedCredits);
        new Chart(document.getElementById('creditChart'), {
            type: 'doughnut',
            data: { labels: ['Đã tích lũy', 'Còn lại'], datasets: [{ data: [@Model.PassedCredits, remain], backgroundColor: ['#12a150', '#e2e8f0'], borderWidth: 0 }] },
            options: { cutout: '70%', plugins: { legend: { position: 'bottom' } } }
        });
    })();
</script>
