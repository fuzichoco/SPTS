@model SPTS.Models.ViewModels.IPagedResult
@{
    // Giữ nguyên các tham số lọc trên URL, chỉ đổi số trang
    string PageUrl(int p)
    {
        var q = Context.Request.Query.ToDictionary(k => k.Key, v => (string?)v.Value.ToString(), StringComparer.OrdinalIgnoreCase);
        q["Page"] = p.ToString();
        return Context.Request.Path + QueryString.Create(q).ToString();
    }
}
<div class="d-flex justify-content-between align-items-center">
    <span class="text-muted">Tổng: @Model.TotalItems bản ghi</span>
    @if (Model.TotalPages > 1)
    {
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page - 1)">&laquo;</a></li>
            @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page + 1)">&raquo;</a></li>
        </ul>
    }
</div>
