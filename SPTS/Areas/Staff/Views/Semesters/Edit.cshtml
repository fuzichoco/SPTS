@model Semester
@{
    var isNew = Model.SemesterId == 0;
    ViewData["Title"] = isNew ? "Thêm học kỳ" : "Sửa học kỳ";
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Danh sách học kỳ</a>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>
<div class="card" style="max-width:720px">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@(isNew ? null : Model.SemesterId)" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
            <input type="hidden" asp-for="SemesterId" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="SemesterName" class="form-label">Tên học kỳ</label>
                    <input asp-for="SemesterName" class="form-control" placeholder="HK1 2024-2025" />
                    <span asp-validation-for="SemesterName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                    <input asp-for="StartDate" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
                    <input asp-for="EndDate" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch"><input asp-for="IsLocked" class="form-check-input" /><label asp-for="IsLocked" class="form-check-label">Khóa điểm học kỳ này</label></div>
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Hủy</a>
                <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Lưu</button>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
