@model List<GradeScale>
@{
    ViewData["Title"] = "Thang điểm";
    var canEdit = User.IsInRole(Role.Admin);
}
<div class="page-header">
    <div>
        <h1 class="page-title">Thang điểm quy đổi</h1>
        <p class="page-sub">Điểm hệ 10 → điểm chữ → điểm hệ 4. Thang điểm được cache trong bộ nhớ (IMemoryCache) 1 giờ.</p>
    </div>
    @if (canEdit)
    {
        <form asp-action="Recalculate" method="post" data-confirm="Tính lại điểm chữ/thang 4 cho mọi học kỳ chưa khóa?">
            <button class="btn btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Tính lại điểm</button>
        </form>
    }
</div>
<div class="row g-4">
    <div class="col-xl-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Điểm chữ</th><th>Từ (hệ 10)</th><th>Đến (hệ 10)</th><th>Hệ 4</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var s in Model)
                    {
                        var fid = "gs" + s.GradeScaleId;
                        <tr>
                            @* <form> không được nằm giữa <tr> và <td>: các ô input gắn vào form qua thuộc tính form="..." *@
                            <td><input form="@fid" name="LetterGrade" value="@s.LetterGrade" class="form-control score-input fw-bold" maxlength="2" readonly="@(!canEdit)" /></td>
                            <td><input form="@fid" name="MinScore" value="@s.MinScore.ToString("0.0")" type="number" step="0.1" min="0" max="10" class="form-control score-input" readonly="@(!canEdit)" /></td>
                            <td><input form="@fid" name="MaxScore" value="@s.MaxScore.ToString("0.0")" type="number" step="0.1" min="0" max="10" class="form-control score-input" readonly="@(!canEdit)" /></td>
                            <td><input form="@fid" name="GradePoint" value="@s.GradePoint.ToString("0.0")" type="number" step="0.5" min="0" max="4" class="form-control score-input" readonly="@(!canEdit)" /></td>
                            <td class="actions">
                                @if (canEdit)
                                {
                                    <form id="@fid" asp-action="Update" method="post">
                                        <input type="hidden" name="GradeScaleId" value="@s.GradeScaleId" />
                                        <button class="btn btn-sm btn-light"><i class="bi bi-floppy me-1"></i>Lưu</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (!canEdit) { <div class="card-footer small text-muted"><i class="bi bi-lock me-1"></i>Chỉ quản trị viên được sửa thang điểm.</div> }
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-calculator me-1"></i>Cách tính</div>
            <div class="card-body small">
                <p class="mb-2"><strong>Điểm tổng kết</strong> = CC × 10% + GK × 30% + CK × 60%</p>
                <p class="mb-2"><strong>Đạt</strong> khi tổng kết ≥ 4.0 (điểm D trở lên).</p>
                <p class="mb-2"><strong>Học lại</strong>: lấy lần có điểm cao nhất để tính GPA.</p>
                <p class="mb-0"><strong>GPA</strong> = Σ(điểm hệ 4 × tín chỉ) / Σ tín chỉ.</p>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><i class="bi bi-award me-1"></i>Xếp loại học lực (hệ 4)</div>
            <ul class="list-group list-group-flush small">
                <li class="list-group-item d-flex justify-content-between">Xuất sắc<span>3.6 – 4.0</span></li>
                <li class="list-group-item d-flex justify-content-between">Giỏi<span>3.2 – 3.59</span></li>
                <li class="list-group-item d-flex justify-content-between">Khá<span>2.5 – 3.19</span></li>
                <li class="list-group-item d-flex justify-content-between">Trung bình<span>2.0 – 2.49</span></li>
                <li class="list-group-item d-flex justify-content-between text-danger">Yếu (cảnh báo)<span>&lt; 2.0</span></li>
            </ul>
        </div>
    </div>
</div>
