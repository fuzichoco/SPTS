@{
    ViewData["Title"] = "Quản lý tài khoản (AJAX)";
    var roles = (List<Role>)ViewBag.Roles;
}
<div id="usersApp" data-list-url="@Url.Action("List")" data-delete-url="@Url.Action("DeleteAjax")">
    <h2>@ViewData["Title"]</h2>
    <div id="alertBox"></div>

    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <input id="keyword" class="form-control" placeholder="Tìm username, họ tên, email..." autocomplete="off" />
        </div>
        <div class="col-md-2">
            <select id="pageSize" class="form-select">
                <option value="5">5 / trang</option>
                <option value="10" selected>10 / trang</option>
                <option value="20">20 / trang</option>
            </select>
        </div>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr><th>Username</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody id="userRows">
            <tr><td colspan="6" class="text-center text-muted">Đang tải...</td></tr>
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center">
        <span id="summary" class="text-muted"></span>
        <ul id="pager" class="pagination mb-0"></ul>
    </div>

    <h4 class="mt-4">Thêm tài khoản</h4>
    <form id="createForm" asp-action="CreateAjax" method="post" class="row g-2">
        <div class="col-md-3"><input name="Username" class="form-control" placeholder="Tên đăng nhập" required /></div>
        <div class="col-md-3"><input name="FullName" class="form-control" placeholder="Họ tên" required /></div>
        <div class="col-md-3"><input name="Email" type="email" class="form-control" placeholder="Email" required /></div>
        <div class="col-md-3"><input name="Password" type="password" class="form-control" placeholder="Mật khẩu (≥ 8 ký tự)" autocomplete="new-password" required /></div>
        <div class="col-12">
            @foreach (var r in roles)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="@r.RoleId" id="role_@r.RoleId" />
                    <label class="form-check-label" for="role_@r.RoleId">@r.RoleName</label>
                </div>
            }
        </div>
        <div class="col-12">
            <button class="btn btn-primary">Thêm</button>
            <div id="createErrors" class="text-danger mt-2"></div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/users-ajax.js" asp-append-version="true"></script>
}
