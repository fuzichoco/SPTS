@model UserFilterViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var roles = (List<Role>)ViewBag.Roles;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm tài khoản</a>
</div>


<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input asp-for="Keyword" class="form-control" placeholder="Tìm username, họ tên, email" /></div>
    <div class="col-md-2">
        <select asp-for="RoleId" asp-items="@(new SelectList(roles, "RoleId", "RoleName"))" class="form-select">
            <option value="">-- Vai trò --</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="IsActive" class="form-select">
            <option value="">-- Trạng thái --</option>
            <option value="true">Hoạt động</option>
            <option value="false">Đã khóa</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="SortOrder" class="form-select">
            <option value="">Mới tạo trước</option>
            <option value="date">Cũ nhất trước</option>
            <option value="name">Tên A-Z</option>
            <option value="name_desc">Tên Z-A</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Lọc</button></div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Username</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Result.Items)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td>@string.Join(", ", u.Roles)</td>
                <td>
                    @if (!u.IsActive) { <span class="badge bg-secondary">Đã khóa</span> }
                    else if (u.IsLockedOut) { <span class="badge bg-warning text-dark">Tạm khóa</span> }
                    else { <span class="badge bg-success">Hoạt động</span> }
                </td>
                <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-secondary">Xem</a>
                    <a asp-action="Edit" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-primary">Sửa</a>
                    @if (u.IsActive && !u.IsLockedOut)
                    {
                        <a asp-action="Delete" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-danger">Khóa</a>
                    }
                    else
                    {
                        <form asp-action="Unlock" asp-route-id="@u.UserId" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-success">Mở khóa</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Result.Items.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr>
        }
    </tbody>
</table>

<partial name="_Pager" model="Model.Result" />
