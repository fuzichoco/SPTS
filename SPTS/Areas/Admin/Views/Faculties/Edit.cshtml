@model Faculty
@{
    var isNew = Model.FacultyId == 0;
    ViewData["Title"] = isNew ? "Thêm khoa" : "Sửa khoa";
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Danh sách khoa</a>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>
<div class="card" style="max-width:860px">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@(isNew ? null : Model.FacultyId)" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
            <input type="hidden" asp-for="FacultyId" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="FacultyCode" class="form-label">Mã khoa</label>
                    <input asp-for="FacultyCode" class="form-control" placeholder="CNTT"/>
                    <span asp-validation-for="FacultyCode" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="FacultyName" class="form-label">Tên khoa</label>
                    <input asp-for="FacultyName" class="form-control" placeholder="Khoa Công nghệ Thông tin"/>
                    <span asp-validation-for="FacultyName" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Hủy</a>
                <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Lưu</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
