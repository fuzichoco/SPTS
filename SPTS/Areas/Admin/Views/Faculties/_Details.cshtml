@model CatalogRowViewModel
<dl class="row">
    <dt class="col-sm-3">Mã khoa</dt><dd class="col-sm-9">@Model.Code</dd>
    <dt class="col-sm-3">Tên khoa</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Số ngành</dt><dd class="col-sm-9"><a asp-controller="Majors" asp-action="Index" asp-route-FacultyId="@Model.Id">@Model.MajorCount</a></dd>
    <dt class="col-sm-3">Số cán bộ</dt><dd class="col-sm-9">@Model.StaffCount</dd>
</dl>
