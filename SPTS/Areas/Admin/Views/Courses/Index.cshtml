@model PagedResult<Course>
@{ ViewData["Title"] = "Học phần"; }
<div class="page-header">
    <div>
        <h1 class="page-title">Học phần</h1>
        <p class="page-sub">Danh mục học phần và điều kiện tiên quyết.</p>
    </div>
    <a asp-action="Edit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm học phần</a>
</div>
<div class="card">
    <div class="card-toolbar">
        <form method="get">
            <partial name="_SearchBox" model="@("Tìm mã hoặc tên học phần")" />
            <button class="btn btn-light"><i class="bi bi-funnel me-1"></i>Lọc</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã HP</th><th>Tên học phần</th><th>Tín chỉ</th><th>Tiên quyết</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model.Items)
            {
                <tr>
                    <td><span class="code">@x.CourseCode</span></td>
                    <td><span class="cell-main">@x.CourseName</span><div class="cell-sub text-truncate" style="max-width:380px">@x.Description</div></td>
                    <td><strong>@x.Credits</strong></td>
                    <td>@foreach (var p in x.Prerequisites) { <span class="pill warn me-1">@p.Prerequisite.CourseCode</span> }</td>
                    <td class="actions">
                    <a asp-action="Edit" asp-route-id="@x.CourseId" class="btn-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                    <form asp-action="Delete" asp-route-id="@x.CourseId" method="post" class="d-inline" data-confirm="Xóa học phần @x.CourseCode?">
                        <button class="btn-icon danger" title="Xóa"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
                </tr>
            }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="5" class="empty"><i class="bi bi-inbox"></i>Không có dữ liệu</td></tr>
        }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><partial name="_Pager" model="Model" /></div>
</div>
