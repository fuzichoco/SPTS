@model Major
@{
    var isNew = Model.MajorId == 0;
    ViewData["Title"] = isNew ? "Thêm ngành" : "Sửa ngành";
}
<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Danh sách ngành</a>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>
<div class="card" style="max-width:860px">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@(isNew ? null : Model.MajorId)" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
            <input type="hidden" asp-for="MajorId" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MajorCode" class="form-label">Mã ngành</label>
                    <input asp-for="MajorCode" class="form-control" placeholder="7480201"/>
                    <span asp-validation-for="MajorCode" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="MajorName" class="form-label">Tên ngành</label>
                    <input asp-for="MajorName" class="form-control" />
                    <span asp-validation-for="MajorName" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="FacultyId" class="form-label">Thuộc khoa</label>
                    <select asp-for="FacultyId" asp-items="ViewBag.Faculties" class="form-select" ><option value="">-- Chọn --</option></select>
                    <span asp-validation-for="FacultyId" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Hủy</a>
                <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Lưu</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
