@model PagedResult<Major>
@{ ViewData["Title"] = "Ngành đào tạo"; }
<div class="page-header">
    <div>
        <h1 class="page-title">Ngành đào tạo</h1>
        <p class="page-sub">Mỗi ngành thuộc một khoa và có nhiều chương trình đào tạo.</p>
    </div>
    <a asp-action="Edit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm ngành</a>
</div>
<div class="card">
    <div class="card-toolbar">
        <form method="get">
            <partial name="_SearchBox" model="@("Tìm mã hoặc tên ngành")" />
            <select name="facultyId" asp-items="ViewBag.Faculties" class="form-select"><option value="">Tất cả khoa</option></select>
            <button class="btn btn-light"><i class="bi bi-funnel me-1"></i>Lọc</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã ngành</th><th>Tên ngành</th><th>Khoa</th><th>CTĐT</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model.Items)
            {
                <tr>
                    <td><span class="code">@x.MajorCode</span></td>
                    <td class="cell-main">@x.MajorName</td>
                    <td>@x.Faculty.FacultyName</td>
                    <td><span class="pill info">@x.Programs.Count CTĐT</span></td>
                    <td class="actions">
                    <a asp-action="Edit" asp-route-id="@x.MajorId" class="btn-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                    <form asp-action="Delete" asp-route-id="@x.MajorId" method="post" class="d-inline" data-confirm="Xóa @x.MajorName?">
                        <button class="btn-icon danger" title="Xóa"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
                </tr>
            }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="5" class="empty"><i class="bi bi-inbox"></i>Không có dữ liệu</td></tr>
        }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><partial name="_Pager" model="Model" /></div>
</div>
