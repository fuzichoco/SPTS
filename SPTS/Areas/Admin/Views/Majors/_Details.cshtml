@model CatalogRowViewModel
<dl class="row">
    <dt class="col-sm-3">Mã ngành</dt><dd class="col-sm-9">@Model.Code</dd>
    <dt class="col-sm-3">Tên ngành</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Khoa</dt><dd class="col-sm-9"><a asp-controller="Faculties" asp-action="Details" asp-route-id="@Model.FacultyId">@Model.FacultyName</a></dd>
    <dt class="col-sm-3">Số CTĐT</dt><dd class="col-sm-9">@Model.ProgramCount</dd>
</dl>
