@model CatalogRowViewModel
@{ ViewData["Title"] = "Xóa ngành"; bool referenced = Model.ProgramCount > 0; }
<h1>Xác nhận xóa ngành</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<partial name="_Details" model="Model" />
@if (referenced)
{
    <div class="alert alert-warning">Không thể xóa vì có dữ liệu đang tham chiếu.</div>
}
else
{
    <p>Bản ghi sẽ bị xóa khỏi danh mục. Thao tác được lưu vào nhật ký hệ thống.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mb-3">
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    </form>
}
<a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
