@model AuditLogDetailViewModel
@{ ViewData["Title"] = "Chi tiết nhật ký"; }
<h2>@ViewData["Title"] #@Model.LogId</h2>
<dl class="row">
    <dt class="col-sm-2">Thời gian</dt><dd class="col-sm-10">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</dd>
    <dt class="col-sm-2">Người dùng</dt><dd class="col-sm-10">@(Model.Username ?? "(hệ thống)")</dd>
    <dt class="col-sm-2">Hành động</dt><dd class="col-sm-10">@Model.Action</dd>
    <dt class="col-sm-2">Bảng / Bản ghi</dt><dd class="col-sm-10">@Model.TableName / @Model.RecordId</dd>
    <dt class="col-sm-2">IP</dt><dd class="col-sm-10">@Model.IpAddress</dd>
</dl>
<div class="row">
    <div class="col-md-6"><h5>Giá trị cũ</h5><pre class="bg-light p-2 border">@Model.OldValue</pre></div>
    <div class="col-md-6"><h5>Giá trị mới</h5><pre class="bg-light p-2 border">@Model.NewValue</pre></div>
</div>
<a asp-action="Index" class="btn btn-link">Quay lại</a>
